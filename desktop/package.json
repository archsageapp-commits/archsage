{
  "name": "@archsage/desktop",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Archsage",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.ts",
    "start": "electron .",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3"
  },
  "author": "Archsage",
  "license": "AGPL-3.0-only",
  "build": {
    "appId": "app.archsage.desktop",
    "productName": "Archsage",
    "electronVersion": "44.9.2",
    "directories": {
      "output": "../release",
      "buildResources": "."
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!dist/**/*.map"
    ],
    "extraFiles": [
      {
        "from": "../LICENSE",
        "to": "LICENSE.Archsage.txt"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Archsage"
    },
    "npmRebuild": false
  }
}
